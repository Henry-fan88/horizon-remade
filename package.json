{
  "name": "horizon-remade",
  "private": true,
  "version": "1.0.0",
  "description": "An open-world browser driving sandbox with racing, procedural environments, weather and multiplayer",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "npm run build && npm start",
    "test": "node --test tools/*.test.mjs tools/car-assets/*.test.mjs",
    "cf:dev": "vite build && wrangler dev",
    "deploy": "node tools/deploy.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "polygon-clipping": "^0.15.7",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "vite": "^8.3.1",
    "wrangler": "^4.148.0"
  }
}
